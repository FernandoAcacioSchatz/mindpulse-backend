# Copie este arquivo pra ".env" e preencha com os valores reais.
# Nunca commitar o ".env" de verdade (ver .gitignore).

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Supabase -> Project Settings -> API -> JWT Settings -> JWT Secret
SUPABASE_JWT_SECRET=
# Chave pública (anon/publishable) -- não é segredo, mas fica configurável.
SUPABASE_ANON_KEY=

GEMINI_API_KEY=

# --- RabbitMQ (CloudAMQP) -----------------------------------------------
# Formato: amqps://usuario:senha@host/vhost
#
# Autorização por papel (Etapa 3 do trabalho de mensageria) -- 3
# credenciais distintas, cada uma só com a permissão que precisa. Ver
# RABBITMQ_AUTORIZACAO.md pros valores exatos de configure/write/read
# de cada usuário no painel do CloudAMQP.

# Credencial ADMIN (acesso total ao vhost) -- usar SÓ pra rodar
# `python -m scripts.provisionar_topologia`. Nunca configurar isso num
# processo que fica no ar (Render/Railway/VM).
RABBITMQ_URL=

# Usuário "radar_publisher" -- só publica na exchange radar.eventos.
# Usada pelos jobs que enfileiram convites/lembretes.
RABBITMQ_URL_PUBLISHER=

# Usuário "radar_consumidor" -- só lê das filas fila.* e publica na
# exchange default (pra mandar mensagem pra DLQ). Usada pelos workers
# consumidores e pelo monitor da DLQ.
RABBITMQ_URL_CONSUMIDOR=

# --- Brevo (e-mail transacional) ----------------------------------------
BREVO_API_KEY=
BREVO_SENDER_EMAIL=contato@radar.app
# Mesma string cadastrada no webhook do painel da Brevo -- protege
# /webhooks/brevo/{chave}.
BREVO_WEBHOOK_SECRET=

# --- Frontend / URLs -----------------------------------------------------
BASE_URL_FRONTEND=https://radar-empresa.vercel.app

# --- Segurança do backend --------------------------------------------------
# Chave de sistema -- qualquer chamador de /executar/*, /notificar-*
# etc. precisa mandar essa mesma string no cabeçalho X-API-Key.
BACKEND_API_KEY=

# E-mails da equipe Radar (separados por vírgula) -- protege /admin/* e
# recebe os alertas de jobs/monitorar_dlq.py.
ADMIN_EMAILS=
